# Copy this file to .env and fill in your key.
ANTHROPIC_API_KEY=

# Optional: which Claude model the agent uses (default claude-haiku-5-5).
# AGENT_MODEL=claude-opus-5-5
# Optional: reasoning effort, low | medium | high (default medium).
# AGENT_EFFORT=high

# Risk-change alert (POST /alerts/check). Callers must send this value in
# the X-Alert-Token header; without it the endpoint is disabled.
# ALERT_TOKEN=pick-a-long-random-string
# Optional: where to POST new alerts as JSON, e.g. a Slack incoming webhook
# (https://hooks.slack.com/services/...; keep it secret) or webhook.site.
# ALERT_WEBHOOK_URL=https://hooks.example.com/...
